      "text": "Ich spreche mit guten Freunden.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0385",
      "text": "Warme Milch ist hier.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0386",
      "text": "Mein Vorname ist Mia.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0387",
      "text": "Mein Nachname ist Weber.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0388",
      "text": "Ich wohne in der Schulstraße.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0389",
      "text": "Meine Hausnummer ist zwölf.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0390",
      "text": "Wie ist Ihre Adresse?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0391",
      "text": "Buchstabieren Sie bitte Ihren Namen!",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0392",
      "text": "Bitte schreiben Sie Ihre Telefonnummer!",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0393",
      "text": "Ich möchte das Formular ausfüllen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0394",
      "text": "Ich suche eine Jacke.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0395",
      "text": "Haben Sie das Hemd in Größe vierzig?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0396",
      "text": "Kann ich die Hose anprobieren?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0397",
      "text": "Die Jacke ist zu groß.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0398",
      "text": "Ich möchte eine kleinere Größe.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0399",
      "text": "Das ist zu teuer.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0400",
      "text": "Kann ich mit Karte bezahlen?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0401",
      "text": "Ich nehme die blaue Jacke.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0402",
      "text": "Ich habe Kopfschmerzen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0403",
      "text": "Mein Hals tut weh.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0404",
      "text": "Ich fühle mich nicht gut.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0405",
      "text": "Ich habe Fieber.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0406",
      "text": "Ich brauche einen Termin.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0407",
      "text": "Wann kann ich zum Arzt kommen?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0408",
      "text": "Ich war gestern beim Arzt.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0409",
      "text": "Können Sie bitte langsam sprechen?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0410",
      "text": "Unsere Wohnung hat drei Zimmer.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0411",
      "text": "Die Küche ist neben dem Bad.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0412",
      "text": "Die Heizung funktioniert nicht.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0413",
      "text": "Das Fenster ist kaputt.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0414",
      "text": "Können Sie das bitte reparieren?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0415",
      "text": "Ich muss mein Zimmer aufräumen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0416",
      "text": "Wir haben die Küche geputzt.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0417",
      "text": "Der Tisch steht vor dem Fenster.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0418",
      "text": "Der Unterricht fängt um neun Uhr an.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0419",
      "text": "Meine Arbeit beginnt um acht Uhr.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0420",
      "text": "Ich habe eine Frage.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0421",
      "text": "Ich verstehe die Aufgabe nicht.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0422",
      "text": "Kannst du das bitte erklären?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0423",
      "text": "Wann haben wir Pause?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0424",
      "text": "Ich habe meine Hausaufgaben gemacht.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0425",
      "text": "Wir müssen morgen früh anfangen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0426",
      "text": "Ich möchte eine Fahrkarte nach Berlin.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0427",
      "text": "Wann fährt der Zug ab?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0428",
      "text": "Der Zug fährt von Gleis drei ab.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0429",
      "text": "Ich fahre mit dem Zug.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0430",
      "text": "Ich habe ein Zimmer gebucht.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0431",
      "text": "Wir bleiben zwei Nächte.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0432",
      "text": "Haben Sie ein freies Zimmer?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0433",
      "text": "Können Sie uns bitte helfen?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0434",
      "text": "Hallo Mia!",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0435",
      "text": "Ich möchte dich einladen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0436",
      "text": "Wir treffen uns um acht Uhr im Park.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0437",
      "text": "Danke für deine Nachricht.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0438",
      "text": "Leider kann ich morgen nicht kommen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0439",
      "text": "Können wir den Termin verschieben?",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0440",
      "text": "Morgen lerne ich Deutsch.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0441",
      "text": "Ich werde morgen Deutsch lernen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0442",
      "text": "Du wirst nach Berlin fahren.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0443",
      "text": "Er wird uns helfen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0444",
      "text": "Wir werden nächste Woche reisen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0445",
      "text": "Ihr werdet hier wohnen.",
      "kind": "course-phrase"
    },
    {
      "id": "course80-audio-0446",
      "text": "Sie werden morgen kommen.",
      "kind": "course-phrase"
    }
  ]
}
